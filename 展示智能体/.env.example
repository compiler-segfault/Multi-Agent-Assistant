# 复制本文件为 .env.local，填入自己的 Key
#   copy .env.example .env.local      (Windows: copy .env.example .env.local)
#
# .env.local 已被 .gitignore 忽略，不会提交到仓库。
# 切勿把真实 Key 写进 .env.example、源码或任何被 git 跟踪的文件。
#
# 变量名必须以 VITE_ 开头，否则前端代码读不到。
VITE_DEEPSEEK_API_KEY=sk-在这里填入你的DeepSeekAPIKey

# 可选：接口地址，不填则默认使用官方地址
VITE_DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
